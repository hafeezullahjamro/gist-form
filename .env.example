# Set these on Netlify as server-side environment variables.
# Never prefix them with VITE_ or commit real credentials.
GOOGLE_SHEET_ID=YOUR_SPREADSHEET_ID
GOOGLE_SHEET_TAB=Registrations
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Alternative: instead of the email and private-key variables above, you may set
# GOOGLE_SERVICE_ACCOUNT_JSON to the complete one-line service-account JSON.
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Public payment details shown to applicants in the form.
VITE_EASYPAISA_ACCOUNT_TITLE="Majid Ali shah"
VITE_EASYPAISA_ACCOUNT_NUMBER="03053940500"

# Private admin dashboard credentials. Set these only in Netlify.
ADMIN_USERNAME=your-private-username
ADMIN_PASSWORD=replace-with-a-strong-password
# Generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters
